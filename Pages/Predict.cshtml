@page
@model PredictModel
@{
    ViewData["Title"] = "FVE data";
}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns@3"></script>
<script src="https://code.jquery.com/jquery-3.3.1.min.js"></script>
<meta charset="utf-8"/>
<div class="text-center">
    <div class="box-body">
        <div class="container">
            <div><h5>@Model.DateMessage</h5></div>
            <p>@Model.BatteryMessage</p>
            <div class="row">
                @if (@Model.CanRerun)
                {
                    <form method="post">
                        <button type="submit" class="btn btn-primary">Vytvoř predikci</button>
                    </form>
                }

                @{
                    Chart(Model.SpotTimeStamps, Model.SpotPrice, "spot", "Spotová cena [CZK/kWh]");
                    Chart(Model.FVEPredictionTimeStamps, Model.FVEPrediction, "fve", "Předpověd výroby FVE [W]");
                    Chart(Model.ConsumptionPredictionTimeStamps, Model.ConsumptionPrediction, "consumption", "Předpověď spotřeby [W]");
                    Chart(Model.PredictedCostTimeStamps, Model.PredictedBuy, "buy", "Nakoupeno [CZK]");
                    Chart(Model.PredictedCostTimeStamps, Model.PredictedSell, "sell", "Prodáno [CZK]");

                    Chart(Model.PredictedBatteryTimeStamps, Model.PredictedBattery, "battery", "Předpověď nabití baterie [%]");

                }
            </div>
        </div>
        @* @{Chart(Model.labels, Model.data, "Price", "bar");} *@
        @* @Html.Raw(Json.Serialize(Model.labels)) *@

    </div>
</div>

@{
    void Chart<L, V>(List<L> labels, List<V> values, string id, string title, string type = "line")
    {
        <div class="col-xl-6 col-md-8 col-sm-12">
            <div class="card mb-4">
                <canvas id="@id" style="width:100%; height:300px"></canvas>
            </div>
        </div>
        <script type="text/javascript">
            $(function () {
                let ctx = document.getElementById("@id").getContext('2d');
                let data = {
                    labels: JSON.parse('@Html.Raw(Json.Serialize(labels))'),
                    datasets: [{
                        label: "@Html.Raw(title)",
                        backgroundColor: 'rgba(54, 162, 235, 0.2)',
                        borderColor: 'rgba(54, 162, 235, 1)',
                        borderWidth: 1,
                        data: JSON.parse('@Html.Raw(Json.Serialize(values))')
                    }]
                };

                var options = {
                    responsive: true,
                    scales: {
                        x: {
                            type: 'time',
                            time: {
                                unit: 'hour',
                                displayFormats: {
                                    hour: "HH:mm"
                                }
                            }
                        },
                        y: {
                            beginAtZero: true
                        }
                    }
                }

                var myChart = new Chart(ctx, {
                    options: options,
                    data: data,
                    type: "@type"
                });
            });
        </script>
    }
}

