@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns@3"></script>
<script src="https://code.jquery.com/jquery-3.3.1.min.js"></script>
<div class="text-center">
    <div class="box-body">
        @* <form method="post">
            @Html.AntiForgeryToken()
            <input asp-for="DataDate" type="date" class="form-control" onchange="this.form.submit()" />
        </form> *@
        <div class="container">
            <div class="row">
                <div class="col-xl-2 col-md-3 col-sm-4">
                    <div class="card mb-4">
                        <form method="post">
                            @* @Html.AntiForgeryToken() *@
                            <input asp-for="DataDate" type="date" class="form-control" onchange="this.form.submit()" />
                        </form>
                    </div>
                </div>
                @{
                    Card("Baterie [%]", "batteryPercentage", Model.initData.BatteryPercentage);
                    Card("Příkon ze sítě [W]", "batteryOutput", Model.initData.BatteryOutput);
                    Card("výkon měniče [W]", "PVEnergy", Model.initData.PVOutput);
                    Chart(Model.timestamps, Model.Battery, "Baterie [%]");
                }
            </div>
        </div>
    </div>
</div>

<script src="~/js/signalr.js"></script>
<script src="~/js/MqttHub.js"></script>

@{
    void Card<T>(string title, string id, T initValue)
    {
        <div class="col-xl-2 col-md-3 col-sm-4">
            <div class="card bg-secondary mb-4">
                <div class="card-header">
                    @title
                </div>
                <div class="card-body" id=@id>
                    @initValue
                </div>
            </div>
        </div>
    }
}


@{
    void Chart<L, V>(List<L> labels, List<V> values, string chartName, string type = "line")
    {
        <div class="col-xl-6 col-md-8 col-sm-12">
            <div class="card mb-4">
                <canvas id="@chartName" style="width:100%; height:300px"></canvas>
            </div>
        </div>
        <script type="text/javascript">
            $(function () {
                let ctx = document.getElementById("@chartName").getContext('2d');
                let data = {
                    labels: JSON.parse('@Html.Raw(Json.Serialize(labels))'),
                    datasets: [{
                        label: "@chartName",
                        backgroundColor: 'rgba(54, 162, 235, 0.2)',
                        borderColor: 'rgba(54, 162, 235, 1)',
                        borderWidth: 1,
                        data: JSON.parse('@Html.Raw(Json.Serialize(values))')
                    }]
                };

                var options = {
                    responsive: true,
                    scales: {
                        x: {
                            type: 'time',
                            time: {
                                unit: 'hour',
                                displayFormats: {
                                    hour: "HH:mm"
                                }
                            }
                        },
                        y: {
                            beginAtZero: true
                        }
                    }
                }

                var myChart = new Chart(ctx, {
                    options: options,
                    data: data,
                    type: "@type"
                });
            });
        </script>
    }
}