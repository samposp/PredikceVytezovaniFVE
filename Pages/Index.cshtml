@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns@3"></script>
<script src="https://code.jquery.com/jquery-3.3.1.min.js"></script>
<div class="text-center">
    <div class="text-sm-end"><small>Aktualizováno: <span id="lastTime">@Model.LastUpdate.ToString("dd.MM.yyyy HH.mm.ss")</span></small></div>

    <div class="box-body">
        <div class="container">
            <div class="row"><h4>Aktuální data</h4></div>
            <div class="row">
                @{
                    // This is updated with signalR in MqttHub.js file!!!
                    Card("Baterie", "batteryPercentage", Model.initData.SoC, "%");
                    Card("Příkon ze sítě", "grid", -Model.initData.P_GRID, "W");
                    Card("Výkon FVE", "PVEnergy", Model.initData.P_PV, "W");
                    Card("Výkon baterie", "battery", Model.initData.P_BAT, "W");
                    Card("Spotřeba", "consumption", Model.initData.P_HOME, "W");
                    Card("Cena za kW", "prize", Model.initData.PRICE_CZK, "CZK");
                }
            </div>
            <div class="row"><h4>Celková data z <span id="date">@Model.initData.Date</span></h4></div>
            <div class="row">
                @{
                    Card("Nakoupeno", "buy", Model.initData.BUY, "CZK");
                    Card("Prodáno", "sell", Model.initData.SELL, "CZK");
                    Card("Energie z FVE", "fve", Model.initData.PVenergy, "kWh");
                    Card("Do baterie", "toBat", Model.initData.ToBAT, "kWh");
                    Card("Z baterie", "fromBat", Model.initData.FromBAT, "kWh");

                    <hr />
                    Chart(Model.timestamps, Model.Battery, "batteryGraph", "Baterie [%]");
                    Chart(Model.timestamps, Model.Consumption, "consumptionGraph", "Spotřeba [W]");
                    // Chart(Model.timestamps, Model.ToBat, "Do baterie [W]");

                    Chart(Model.timestamps, Model.Production, "fveGraph", "Výkon fotovoltaické elektrárny [W]");
                    // Chart(Model.timestamps, Model.FromBat, "Z baterie [W]");

                    Chart(Model.timestamps, Model.Grid, "gridGraph", "Příkon ze sítě [W]");
                    // Chart(Model.timestamps, Model.Sell, "Prodej [W]");
                    // Chart(Model.timestamps, Model.Buy, "Koupe [W]");
                }
            </div>
        </div>
    </div>
</div>

<script src="~/js/signalr.js"></script>
<script src="~/js/MqttHub.js"></script>

@{
    void Card<T>(string title, string id, T initValue, string unit = "")
    {
        <div class="col-xl-2 col-md-3 col-sm-4">
            <div class="card bg-secondary mb-4">
                <div class="card-header">
                    @title
                </div>
                <div class="card-body" >
                    <span id=@id>@initValue</span> @unit
                </div>
            </div>
        </div>
    }
}

@{
    void Chart<L, V>(List<L> labels, List<V> values, string id, string title, string type = "line")
    {
        <div class="col-xl-6 col-md-8 col-sm-12">
            <div class="card mb-4">
                <canvas id="@id" style="width:100%; height:300px"></canvas>
            </div>
        </div>
        <script type="text/javascript">
            $(function () {
                window.charts = window.charts || {};
                const ctx = document.getElementById("@id").getContext('2d');
                const data = {
                    labels: JSON.parse('@Html.Raw(Json.Serialize(labels))'),
                    datasets: [{
                        label: "@Html.Raw(title)",
                        backgroundColor: 'rgba(54, 162, 235, 0.2)',
                        borderColor: 'rgba(54, 162, 235, 1)',
                        borderWidth: 1,
                        data: JSON.parse('@Html.Raw(Json.Serialize(values))')
                    }]
                };

                var options = {
                    responsive: true,
                    scales: {
                        x: {
                            type: 'time',
                            time: {
                                unit: 'hour',
                                displayFormats: {
                                    hour: "HH:mm"
                                }
                            }
                        },
                        y: {
                            beginAtZero: true
                        }
                    }
                }

                window.charts["@id"] = new Chart(ctx, {
                    options: options,
                    data: data,
                    type: "@type"
                });
            });
        </script>
    }
}