@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <div class="box-body">
        <div class="container">
            <div id="mqtt"></div>
            <div class="row">
                @{
                    Card("Baterie [%]", "batteryPercentage", Model.initData.BatteryPercentage);
                    Card("Výkon baterie", "batteryOutput", Model.initData.BatteryOutput);
                    Card("Výkon FVE", "PVEnergy", Model.initData.PVOutput);
                }
            </div>
        </div>
    </div>
</div>

<script src="~/js/signalr.js"></script>
<script src="~/js/MqttHub.js"></script>


@{
    void Card<T>(string title, string id, T initValue) {
        <div class="col-xl-2 col-md-3 col-sm-4">
            <div class="card bg-secondary mb-4">
                <div class="card-header">
                    @title
                </div>
                <div class="card-body" id=@id>
                    @initValue
                </div>
            </div>
        </div>
    }
}