@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns@3"></script>
<script src="https://code.jquery.com/jquery-3.3.1.min.js"></script>
<div class="text-center">
    <div class="box-body">

        <div class="container">
            <h4>Aktuální data</h4>
            <div class="row">
                @{
                    // This is updated with signalR in MqttHub.js file!!!
                    Card("Baterie", "batteryPercentage", Model.initData.SoC, "%");
                    Card("Příkon ze sítě", "grid", -Model.initData.P_GRID, "W");
                    Card("Výkon měniče", "PVEnergy", Model.initData.P_PV, "W");
                    Card("Celková spotřeba", "consumption", Model.initData.Consumption, "W");

                    Chart(Model.timestamps, Model.Battery, "batteryGraph", "Baterie [%]");
                    Chart(Model.timestamps, Model.Consumption, "consumptionGraph", "Spotřeba [W]");
                    // Chart(Model.timestamps, Model.ToBat, "Do baterie [W]");

                    Chart(Model.timestamps, Model.Production, "fveGraph", "Výkon fotovoltaické elektrátny [W]");
                    // Chart(Model.timestamps, Model.FromBat, "Z baterie [W]");

                    Chart(Model.timestamps, Model.Grid, "gridGraph", "Příkon ze sítě [W]");
                    // Chart(Model.timestamps, Model.Sell, "Prodej [W]");
                    // Chart(Model.timestamps, Model.Buy, "Koupe [W]");
                }
            </div>
        </div>
    </div>
</div>

<script src="~/js/signalr.js"></script>
<script src="~/js/MqttHub.js"></script>

@{
    void Card<T>(string title, string id, T initValue, string unit = "")
    {
        <div class="col-xl-2 col-md-3 col-sm-4">
            <div class="card bg-secondary mb-4">
                <div class="card-header">
                    @title
                </div>
                <div class="card-body" id=@id>
                    @initValue @unit
                </div>
            </div>
        </div>
    }
}

@{
    void Chart<L, V>(List<L> labels, List<V> values, string id, string title, string type = "line")
    {
        <div class="col-xl-6 col-md-8 col-sm-12">
            <div class="card mb-4">
                <canvas id="@id" style="width:100%; height:300px"></canvas>
            </div>
        </div>
        <script type="text/javascript">
            $(function () {
                let ctx = document.getElementById("@id").getContext('2d');
                let data = {
                    labels: JSON.parse('@Html.Raw(Json.Serialize(labels))'),
                    datasets: [{
                        label: "@Html.Raw(title)",
                        backgroundColor: 'rgba(54, 162, 235, 0.2)',
                        borderColor: 'rgba(54, 162, 235, 1)',
                        borderWidth: 1,
                        data: JSON.parse('@Html.Raw(Json.Serialize(values))')
                    }]
                };

                var options = {
                    responsive: true,
                    scales: {
                        x: {
                            type: 'time',
                            time: {
                                unit: 'hour',
                                displayFormats: {
                                    hour: "HH:mm"
                                }
                            }
                        },
                        y: {
                            beginAtZero: true
                        }
                    }
                }

                var myChart = new Chart(ctx, {
                    options: options,
                    data: data,
                    type: "@type"
                });
            });
        </script>
    }
}