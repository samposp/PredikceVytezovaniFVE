@page
@model PredikceVytěžováníFVE.Pages.FVEModel
@{
    ViewData["Title"] = "FVE";
}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns@3"></script>
<script src="https://code.jquery.com/jquery-3.3.1.min.js"></script>
<div class="text-center">
    <div class="box-body">
        <div class="container">
            <div class="row">
                <div class="col-xl-2 col-md-3 col-sm-4">
                    <div class="card mb-4">
                        <form method="post">
                            <input asp-for="DataDate" type="date" class="form-control" onchange="this.form.submit()" />
                        </form>
                    </div>
                </div>
            </div>
            <div class="row">
                @{
                    Chart(Model.timestamps, Model.Battery, "battery", "Baterie [%]");
                    Chart(Model.timestamps, Model.Consumption, "consumption", "Spotřeba [W]");

                    Chart(Model.timestamps, Model.Production, "fve", "Energie z FVE [W]");
                    Chart(Model.timestamps, Model.Grid, "grid", "Energie ze sítě [W]");

                    Chart(Model.timestamps, Model.ToBat, "tobat", "Do baterie [kW]");
                    Chart(Model.timestamps, Model.FromBat, "frombat", "Z baterie [kW]");

                    Chart(Model.timestamps, Model.Sell, "sell", "Prodáno [kWh]");
                    Chart(Model.timestamps, Model.Buy, "buy", "Nakoupeno [kWh]");

                    if (Model.CheckBuyData)
                    {
                        Chart(Model.CosttimeStamp, Model.Cost, "buy2", "Nakoupeno cena [CZK]");
                    }
                }
            </div>
        </div>
    </div>
</div>


@{
    void Chart<L, V>(List<L> labels, List<V> values, string id, string title, string type = "line")
    {
        <div class="col-xl-6 col-md-8 col-sm-12">
            <div class="card mb-4">
                <canvas id="@id" style="width:100%; height:300px"></canvas>
            </div>
        </div>
        <script type="text/javascript">
            $(function () {
                window.charts = window.charts || {};
                const ctx = document.getElementById("@id").getContext('2d');
                const data = {
                    labels: JSON.parse('@Html.Raw(Json.Serialize(labels))'),
                    datasets: [{
                        label: "@Html.Raw(title)",
                        backgroundColor: 'rgba(54, 162, 235, 0.2)',
                        borderColor: 'rgba(54, 162, 235, 1)',
                        borderWidth: 1,
                        data: JSON.parse('@Html.Raw(Json.Serialize(values))')
                    }]
                };

                var options = {
                    responsive: true,
                    scales: {
                        x: {
                            type: 'time',
                            time: {
                                unit: 'hour',
                                displayFormats: {
                                    hour: "HH:mm"
                                }
                            }
                        },
                        y: {
                            beginAtZero: true
                        }
                    },
                    plugins: {
                        tooltip: {
                            callbacks: {
                                title: function(context) {
                                    const value = context[0].parsed.x; // timestamp on time scale
                                    return new Intl.DateTimeFormat("cs-CZ", {
                                      dateStyle: "medium",
                                      timeStyle: "short"
                                    }).format(value);
                                }
                            }
                        }
                    }
                }

                window.charts["@id"] = new Chart(ctx, {
                    options: options,
                    data: data,
                    type: "@type"
                });
            });
        </script>
    }
}