@page
@model PredikceVytěžováníFVE.Pages.SettingsModel
@{
    ViewData["Title"] = "Nastavení";
}

<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<form method="post" class="form-horizontal">
    <div class="container">
        <div class="row">
            <div class="col col-md-4 mt-2">
                <h4>Fotovoltaická elektrárna</h4>
                <div class="form-group row p-2">
                    <label class="col-form-label col-sm-8">Zeměpisná šířka</label>
                    <div class="col-sm-4">
                        <input asp-for="FveInfo.Latitude" type="number" class="form-control" />
                    </div>
                </div>
                <div class="form-group row p-2">
                    <label class="col-form-label col-sm-8">Zeměpisná délka</label>
                    <div class="col-sm-4">
                        <input asp-for="FveInfo.Longitude" type="number" class="form-control" />
                    </div>
                </div>
                <div class="form-group row p-2">
                    <label class="col-form-label col-sm-8">Úhel naklonění</label>
                    <div class="col-sm-4">
                        <input asp-for="FveInfo.Declination" type="number" class="form-control" />
                    </div>
                </div>
                <div class="form-group row p-2">
                    <label class="col-form-label col-sm-8">Azimut</label>
                    <div class="col-sm-4">
                        <input asp-for="FveInfo.Azimuth" type="number" class="form-control" />
                    </div>
                </div>
                <div class="form-group row p-2">
                    <label class="col-form-label col-sm-8">Maximální výkon [kW]</label>
                    <div class="col-sm-4">
                        <input asp-for="FveInfo.PeakPower" type="number" class="form-control" />
                    </div>
                </div>
                <h4>Kontrola nabíjení baterie</h4>
                <div class="form-group row p-2">
                    <label class="col-form-label col-sm-8">Minimální cena pro prodej [CZK/kWh]</label>
                    <div class="col-sm-4">
                        <input asp-for="ControlInfo.MinSellPrice" type="number" class="form-control" />
                    </div>
                </div>
                <div class="form-group row p-2">
                    <label class="col-form-label col-sm-8">Maximální počet nabíjení ze sítě za den</label>
                    <div class="col-sm-4">
                        <input asp-for="ControlInfo.MaxChargingBlocks" type="number" class="form-control" />
                    </div>
                </div>
            </div>
            <div class="col col-md-4 mt-2">
                <div class="container">
                    <h4>Baterie</h4>
                    <div class="form-group row p-2">
                        <label class="col-form-label col-sm-8">Kapacita baterie [kWh]</label>
                        <div class="col-sm-4">
                            <input asp-for="BatteryInfo.Capacity" type="number" class="form-control" />
                        </div>
                    </div>
                    <div class="form-group row p-2">
                        <label class="col-form-label col-sm-8">Rychlost nabíjení [kW]</label>
                        <div class="col-sm-4">
                            <input asp-for="BatteryInfo.ChargeSpeed" type="number" class="form-control" />
                        </div>
                    </div>
                    <div class="form-group row p-2">
                        <label class="col-form-label col-sm-8">Minimální kapacita [%]</label>
                        <div class="col-sm-4">
                            <input asp-for="BatteryInfo.MinLevel" type="number" class="form-control" />
                        </div>
                    </div>
                    <div class="form-group row p-2">
                        <label class="col-form-label col-sm-8">Maximální kapacita [%]</label>
                        <div class="col-sm-4">
                            <input asp-for="BatteryInfo.MaxLevel" type="number" class="form-control" />
                        </div>
                    </div>
                </div>
                @* </div>
            <div class="col col-md-4 mt-2"> *@
                <div class="container pt-3">
                    <h4>MQTT</h4>
                    <div class="form-group row p-2">
                        <label class="col-form-label col-sm-6">Broker</label>
                        <div class="col-sm-6">
                            <input asp-for="ApiInfo.MqttBroker" placeholder="••••••••" type="password" class="form-control" />
                        </div>
                    </div>
                    <div class="form-group row p-2">
                        <label class="col-form-label col-sm-6">Topic pro získání dat</label>
                        <div class="col-sm-6">
                            <input asp-for="ApiInfo.MqttDataTopic" placeholder="••••••••" type="password" class="form-control" />
                        </div>
                    </div>
                    <div class="form-group row p-2">
                        <label class="col-form-label col-sm-6">Topic pro odeslání predikce</label>
                        <div class="col-sm-6">
                            <input asp-for="ApiInfo.MqttPredictTopic" placeholder="••••••••" type="password" class="form-control" />
                        </div>
                    </div>
                    <h4>API</h4>
                    <div class="form-group row p-2">
                        <label class="col-form-label col-sm-6">Klíč k <a href="https://wp2.pvforecast.cz/en/subscription/">PV Forecast</a></label>
                        <div class="col-sm-6">
                            <input asp-for="ApiInfo.PvForecastApiKey" placeholder="••••••••" type="password" class="form-control" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="col col-md-4 mt-2">
                <div class="container">
                    <h4>Modely pro předpověď spotřeby</h4>
                    <div class="form-group row p-2">
                        <label class="col-form-label col-sm-8">Počet dnů pro trénování modelů</label>
                        <div class="col-sm-4">
                            <input asp-for="ModelInfo.HistoryDays" type="number" class="form-control" />
                        </div>
                    </div>
                    <div class="form-group row p-2">
                        <label class="col-form-label col-sm-8">Přetrénovat modely</label>
                        <div class="col-sm-4">
                            <input asp-for="ModelInfo.Retrain" type="checkbox" class="form-check-label" />
                        </div>
                    </div>
                    <h6>SARIMA</h6>
                    <div class="form-group row p-2">
                        <label class="col-form-label col-sm-6">Order</label>
                        <div class="col-sm-6">
                            <div class="row">
                                <div class="col nopadding">
                                    <input asp-for="ModelInfo.SARIMAX.Order[0]" type="" class="form-control" />
                                </div>
                                <div class="col nopadding">
                                    <input asp-for="ModelInfo.SARIMAX.Order[1]" type="" class="form-control" />
                                </div>
                                <div class="col nopadding">
                                    <input asp-for="ModelInfo.SARIMAX.Order[2]" type="" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="form-group row p-2">
                        <label class="col-form-label col-sm-6">Seasonal Order</label>
                        <div class="col-sm-6">
                            <div class="row">
                                <div class="col nopadding">
                                    <input asp-for="ModelInfo.SARIMAX.SeasonalOrder[0]" type="" class="form-control" />
                                </div>
                                <div class="col nopadding">
                                    <input asp-for="ModelInfo.SARIMAX.SeasonalOrder[1]" type="" class="form-control" />
                                </div>
                                <div class="col nopadding">
                                    <input asp-for="ModelInfo.SARIMAX.SeasonalOrder[2]" type="" class="form-control" />
                                </div>
                                <div class="col nopadding">
                                    <input asp-for="ModelInfo.SARIMAX.SeasonalOrder[3]" type="" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <h6>XGBoost</h6>
                    <div class="form-group row p-2">
                        <label class="col-form-label col-sm-8">Max depth</label>
                        <div class="col-sm-4">
                            <input asp-for="ModelInfo.XGBoostParams.MaxDepth" type="number" class="form-control" />
                        </div>
                    </div>
                    <div class="form-group row p-2">
                        <label class="col-form-label col-sm-8">Subsample</label>
                        <div class="col-sm-4">
                            <input asp-for="ModelInfo.XGBoostParams.Subsample" type="number" class="form-control" />
                        </div>
                    </div>
                    <div class="form-group row p-2">
                        <label class="col-form-label col-sm-8">N estimators</label>
                        <div class="col-sm-4">
                            <input asp-for="ModelInfo.XGBoostParams.NEstimators" type="number" class="form-control" />
                        </div>
                    </div>
                    <div class="form-group row p-2">
                        <label class="col-form-label col-sm-8">Learning Rate</label>
                        <div class="col-sm-4">
                            <input asp-for="ModelInfo.XGBoostParams.LearningRate" type="number" class="form-control" />
                        </div>
                    </div>
                    <div class="form-group row p-2">
                        <label class="col-form-label col-sm-8">ColsampleBytree</label>
                        <div class="col-sm-4">
                            <input asp-for="ModelInfo.XGBoostParams.ColsampleBytree" type="number" class="form-control" />
                        </div>
                    </div>

                </div>
            </div>
            <div class="row">
                <div class="form-group col-xl-4 col-md-4 col-sm-3 m-4">
                    <button type="button" id="openSaveDialog" class="btn btn-primary">Uložit změny</button>
                </div>
            </div>
        </div>
    </div>
    <dialog id="saveDialog">
        <div class="mb-3">
            <h5>Potvrzení uložení</h5>
            <p>Zadejte heslo pro uložení změn.</p>
        </div>

        <div class="mb-3">
            <label asp-for="SavePassword" class="form-label">Heslo</label>
            <input asp-for="SavePassword" type="password" class="form-control" autocomplete="off" />
            <span asp-validation-for="SavePassword" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="button" id="confirmSave" class="btn btn-primary">Potvrdit</button>
            <button type="button" id="cancelSave" class="btn btn-secondary">Zrušit</button>
        </div>
    </dialog>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const form = document.querySelector("form");
        const dialog = document.getElementById("saveDialog");
        const openButton = document.getElementById("openSaveDialog");
        const confirmButton = document.getElementById("confirmSave");
        const cancelButton = document.getElementById("cancelSave");
        const passwordInput = document.getElementById("SavePassword");

        openButton.addEventListener("click", function () {
            if (dialog.showModal) {
                dialog.showModal();
                setTimeout(() => passwordInput?.focus(), 0);
            } else {
                // fallback for very old browsers
                dialog.setAttribute("open", "open");
                passwordInput?.focus();
            }
        });

        cancelButton.addEventListener("click", function () {
            dialog.close();
        });

        confirmButton.addEventListener("click", function () {
            form.submit();
        });
    </script>
}
@if (!ViewContext.ModelState.IsValid)
{
    <script>
        window.addEventListener("load", () => {
            const dialog = document.getElementById("saveDialog");
            if (dialog && dialog.showModal) {
                dialog.showModal();
            }
        });
    </script>
}